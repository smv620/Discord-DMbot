#!/usr/bin/env bash
# Changes one ordinary (non-secret) setting in the server's .env, so nobody has to edit .env by
# hand (painful from a phone over SSH). It is the twin of scripts/set-key: set-key is for keys,
# tokens and secrets and hides what you paste; this one is for everything else, so it shows the
# value that is there now, and Enter alone leaves it as it is.
#
#   scripts/set-variables                    pick from a numbered list
#   scripts/set-variables MAIL_ALERTS_FROM   change that one
#
# It lists every setting in .env.example, also one written as "# NAME=value" (a switch left
# commented out until needed; only "#", one space, then NAME=, so a prose comment doesn't count)
# when DMbot's config.py reads that name, EXCEPT: keys, tokens and secrets (names ending in
# _KEY, _TOKEN or _SECRET: use scripts/set-key), every password and password hash (the database
# passwords would lock DMbot out of its saved data; the admin password has its own script,
# scripts/set-admin-password) and DATABASE_URL (it has a password inside it). Those never show
# up here, so a value read off the screen is never a secret.
# Type - alone to empty a setting. Values can't hold quotes, $, #, a backslash or a hidden
# character: Docker Compose would read some of them differently from how they were typed.
# Before a change the old .env is copied to .env.backup-<date>-<time> (private, like .env), as
# scripts/update-env does; set-key keeps no copy. The new .env replaces the old file, so a
# symlinked .env becomes a plain file owned by whoever runs this.
#
# What each setting does is in scripts/setting-descriptions (NAME|short line|detail): the short
# line shows in the list, the detail when a setting is picked, before the value is asked for. A
# test checks that every setting in the menu has a line there (#2181).
#
# Tests point DMBOT_ENV_FILE, DMBOT_ENV_EXAMPLE and DMBOT_DOCKER at stand-ins, and set
# DMBOT_TEST_NO_TERMINAL to pipe the answers in; DMBOT_CONFIG_SOURCE points at the file that
# stands in for core/src/dmbot/config.py.
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
env_file=${DMBOT_ENV_FILE:-$root/.env}
example=${DMBOT_ENV_EXAMPLE:-$root/.env.example}
docker=${DMBOT_DOCKER:-docker}
config_source=${DMBOT_CONFIG_SOURCE:-$root/core/src/dmbot/config.py}
descriptions=${DMBOT_SETTING_DESCRIPTIONS:-$root/scripts/setting-descriptions}

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

[[ -f $example ]] || fail "Can't find .env.example in $root.
Get it back with: git checkout .env.example"

# Without a terminal the prompts can't work (ssh host scripts/set-variables). Only the
# test-only switch skips this, so pointing DMBOT_ENV_FILE elsewhere doesn't.
[[ -t 0 || -n ${DMBOT_TEST_NO_TERMINAL:-} ]] || fail "Log in to the server first, then run:
scripts/set-variables"

# Every setting in .env.example, in file order, except what belongs to set-key, a password or
# a password hash, and DATABASE_URL.
# One rule decides this for the menu and for a name typed in, so they can't disagree. It looks
# anywhere in the name (SECRET_FOO, FOO_PASSWORD_FILE) and adds a few usual endings as a net.
secret_names='PASSWORD|SECRET|TOKEN|_KEY|_HASH|_PASS$|_SALT|_DSN|CREDENTIAL|^DATABASE_URL$'
# A commented "# NAME=value" line is only a setting if config.py reads that name (#1970): this
# keeps notes like "# COMPOSE_PROFILES=web. ..." and names DMbot doesn't know out of the list.
reads_setting() {
  [[ -e $config_source ]] && grep -rqF "\"$1\"" "$config_source"
}
mapfile -t active < <(sed -nE 's/^([A-Z][A-Z0-9_]*)=.*/\1/p' "$example")
mapfile -t commented < <(sed -nE 's/^# ([A-Z][A-Z0-9_]*)=.*/\1/p' "$example")
# File order: each name where it first appears, active or commented.
mapfile -t listed < <(sed -nE 's/^(# )?([A-Z][A-Z0-9_]*)=.*/\2/p' "$example" | awk '!seen[$0]++')
declare -A is_commented_only=()
choices=()
for k in "${listed[@]}"; do
  grep -qE "$secret_names" <<<"$k" && continue
  if printf '%s\n' "${active[@]}" | grep -qxF -- "$k"; then
    choices+=("$k")
  elif printf '%s\n' "${commented[@]}" | grep -qxF -- "$k" && reads_setting "$k"; then
    choices+=("$k")
    is_commented_only[$k]=1
  fi
done

# The short line, or the detail, written for a setting ("" when it has none). Field 1 is the name;
# the text is everything after it, so a description may not hold the field separator.
describe() {
  [[ -f $descriptions ]] || return 0
  awk -F'|' -v name="$1" -v field="$2" '$1 == name { print $field; exit }' "$descriptions"
}

is_choice() {
  local k
  for k in "${choices[@]}"; do [[ $k == "$1" ]] && return 0; done
  return 1
}

# What .env says now (empty if it has no such line). The last line wins, as in Docker Compose.
current_value() {
  [[ -f $env_file ]] || return 0
  local raw
  raw=$(sed -nE "s/^$1=(.*)$/\1/p" "$env_file" | tail -n 1)
  # A value written by hand may be wrapped in one pair of quotes: show what it means.
  if [[ $raw =~ ^\"(.*)\"$ || $raw =~ ^\'(.*)\'$ ]]; then raw=${BASH_REMATCH[1]}; fi
  printf '%s' "$raw"
}

# What DMbot uses when .env says nothing: the value in .env.example, if it has one (a commented
# "# NAME=value" line says it too).
default_value() {
  sed -nE "s/^(# )?$1=(.*)$/\2/p" "$example" | tail -n 1
}

# Whether .env has an active line for the setting at all.
in_env() {
  [[ -f $env_file ]] && grep -q "^$1=" "$env_file"
}

if [[ $# -gt 1 ]]; then
  fail "Not saved. Give only the setting name, like:
scripts/set-variables MAIL_ALERTS_FROM"
elif [[ $# -eq 1 ]]; then
  [[ $1 =~ ^[A-Za-z][A-Za-z0-9_]{2,60}$ ]] || fail "Not saved. That doesn't look like a setting name.
Run scripts/set-variables with no name to pick from a list."
  name=${1^^}   # phones like to type lower case
else
  echo "Which setting do you want to change?"
  for i in "${!choices[@]}"; do
    status="empty"
    [[ -n $(current_value "${choices[$i]}") ]] && status="set"
    # A switch left commented in .env.example, and not in .env yet: say so.
    if [[ -n ${is_commented_only[${choices[$i]}]:-} ]] && ! in_env "${choices[$i]}"; then
      status="not in .env"
    fi
    short=$(describe "${choices[$i]}" 2)
    printf '  %d) %s (%s)%s\n' "$((i + 1))" "${choices[$i]}" "$status" "${short:+ - $short}"
  done
  pick=""
  read -r -p "Type a number and press Enter (just Enter cancels): " pick || true
  if [[ -z $pick ]]; then
    echo "Cancelled. Nothing was changed."
    exit 0
  fi
  if ! [[ $pick =~ ^[1-9][0-9]{0,2}$ ]] || ((pick > ${#choices[@]})); then
    fail "Not saved: pick a number from the list.
Run scripts/set-variables to see it again."
  fi
  name=${choices[$((pick - 1))]}
fi

case $name in
  ADMIN_PASSWORD_HASH)
    fail "Not saved: the admin password has its own script.
Run: scripts/set-admin-password" ;;
  *_KEY | *_TOKEN | *_SECRET | SMTP_APP_PASSWORD)
    fail "Not saved: $name is a key or secret, so it has its own hidden prompt.
Run: scripts/set-key $name" ;;
esac
if grep -qE "$secret_names" <<<"$name"; then
  fail "Not saved: $name looks like a secret or a password, so it isn't set here.
Keys and tokens: scripts/set-key. Database passwords can't be changed this way:
changing one would lock DMbot out of its saved data."
fi
is_choice "$name" || fail "Not saved. $name isn't one of DMbot's settings.
Run scripts/set-variables with no name to pick from a list.
For anything else, edit .env: nano $root/.env"

old=$(current_value "$name")
default=$(default_value "$name")
echo "$name"
detail=$(describe "$name" 3)
if [[ -n $detail ]]; then
  # Wrapped for a phone's width; the current value is not part of it (it is shown below).
  fold -s -w 76 <<<"$detail" | sed 's/ *$//; s/^/  /'
  echo
fi
if [[ -n $old ]]; then
  echo "  Now: $old"
elif [[ -n $default ]]; then
  echo "  Now: nothing in .env, so DMbot uses its own default: $default"
else
  echo "  Now: empty"
fi
value=""
read -r -p "New value, then Enter (just Enter keeps it, - empties it): " value || true
# Pasting from a phone often adds spaces or a line ending.
value=${value//$'\r'/}
value=${value#"${value%%[![:space:]]*}"}
value=${value%"${value##*[![:space:]]}"}

if [[ -z $value ]]; then
  echo "Nothing typed, so $name stays as it is. Nothing was changed."
  exit 0
fi
[[ $value == "-" ]] && value=""

# Anything the .env file or Docker Compose would read differently from how it was typed.
if [[ $value =~ [\"\'\$\#\`\\] || $value =~ [[:cntrl:]] ]]; then
  fail "Not saved: the value has a quote, \$, #, a backslash or a hidden character,
and those get misread. Type it again without them, then run: scripts/set-variables $name"
fi
# Zero-width characters and the non-breaking space ride along with some phone pastes and look
# like nothing. Matched as bytes, so accents and other real letters are still fine.
for hidden in $'\xe2\x80\x8b' $'\xe2\x80\x8c' $'\xe2\x80\x8d' $'\xe2\x81\xa0' $'\xef\xbb\xbf' $'\xc2\xa0'; do
  [[ $value == *"$hidden"* ]] && fail "Not saved: the paste has a hidden character in it (a zero-width or
non-breaking space). Type the value again by hand, then run: scripts/set-variables $name"
done
((${#value} <= 500)) || fail "Not saved: that value is too long (500 characters at most).
Run: scripts/set-variables $name"

umask 077
if [[ -f $env_file && $old == "$value" ]] && grep -q "^$name=" "$env_file"; then
  chmod 600 "$env_file"
  echo "$name already has that value. Nothing was changed."
  exit 0
fi

backup=""
if [[ -f $env_file ]]; then
  backup="$env_file.backup-$(date +%Y%m%d-%H%M%S)"
  cp "$env_file" "$backup"
  chmod 600 "$backup"
  chown --reference="$env_file" "$backup" 2>/dev/null || true
else
  cp "$example" "$env_file"
  echo "No .env yet, so I made one from .env.example.
Fill in the database passwords too: see docs/DEPLOY.md, step 3."
fi
# Write a new copy next to .env, then swap it in, so .env is never left half-written.
tmp=$(mktemp "$env_file.XXXXXX")
trap 'rm -f "$tmp"' EXIT
NAME=$name VALUE=$value awk '
  BEGIN { prefix = ENVIRON["NAME"] "=" }
  index($0, prefix) == 1 { print prefix ENVIRON["VALUE"]; done = 1; next }
  { print }
  END { if (!done) print prefix ENVIRON["VALUE"] }
' "$env_file" >"$tmp"
chmod 600 "$tmp"
chown --reference="$env_file" "$tmp" 2>/dev/null || true
mv -f "$tmp" "$env_file"
trap - EXIT

if [[ -z $value ]]; then
  echo "Saved: $name is now empty."
else
  echo "Saved: $name is now $value"
fi
if [[ -n $backup ]]; then
  echo "Old .env kept as $backup
Once DMbot runs fine, delete it: rm $backup"
fi

# Offer a restart only when DMbot is already up here (or crash-looping, perhaps on a bad
# value), so this never starts a copy that was stopped on purpose: only one copy may be
# logged in to Discord at a time. It restarts the services that are running now.
compose=("$docker" compose -f "$root/docker-compose.yml")
running=""
if command -v "$docker" >/dev/null; then
  running=$("${compose[@]}" ps --status running --status restarting --services 2>/dev/null || true)
fi
if grep -qx core <<<"$running"; then
  restart=()
  for svc in core ears web-api; do
    grep -qx "$svc" <<<"$running" && restart+=("$svc")
  done
  answer=""
  read -r -p "Restart DMbot now so it uses the new value? It leaves voice for about a minute. [y/N] " answer || true
  if [[ $answer =~ ^[Yy] ]]; then
    "${compose[@]}" up -d --no-deps "${restart[@]}"
    echo "Done. DMbot is using the new value."
    exit 0
  fi
fi
echo "Not restarted. If DMbot should be running, this makes it use the new value:
cd $root && docker compose up -d"
