#!/usr/bin/env bash
# Sets the admin page's password (#772): asks for it twice without showing it, hashes it
# (argon2id, inside DMbot's own image, so the server needs no extra tools) and writes only
# the hash to .env as ADMIN_PASSWORD_HASH. The password itself is never stored, shown or
# put on a command line.
#
#   scripts/set-admin-password
#
# The admin's email must also be in ADMIN_EMAILS. Restart the website API afterwards.
# Tests point DMBOT_ENV_FILE, DMBOT_ENV_EXAMPLE and DMBOT_HASHER at stand-ins, and set
# DMBOT_TEST_NO_TERMINAL to pipe the password in.
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
env_file=${DMBOT_ENV_FILE:-$root/.env}
example=${DMBOT_ENV_EXAMPLE:-$root/.env.example}
min_length=16

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

[[ -f $example ]] || fail "Can't find .env.example in $root.
Get it back with: git checkout .env.example"

# Without a terminal the typing can't be hidden (ssh host scripts/..., or another Claude
# session running it). The owner reads this, so it also stops a password going into a chat.
[[ -t 0 || -n ${DMBOT_TEST_NO_TERMINAL:-} ]] || fail "Nothing saved: type this password yourself, where nobody else can see it.
Never paste it into a chat. Log in to the server yourself (ssh), then run:
cd $root && scripts/set-admin-password"

# Hashes the password read from standard input and prints the hash's .env form.
hash_password() {
  if [[ -n ${DMBOT_HASHER:-} ]]; then
    "$DMBOT_HASHER"
  else
    docker compose -f "$root/docker-compose.yml" run --rm --no-deps -T web-api \
      python -m dmbot.web.hash_admin_password
  fi
}

first=""
second=""
printf 'New admin password: %d characters or more. Your typing stays hidden.\n' "$min_length"
printf 'Password: '
# IFS= keeps spaces at either end: the browser sends them, so the hash must include them.
IFS= read -r -s first || true
echo
printf 'Same password again: '
IFS= read -r -s second || true
echo

[[ $first == "$second" ]] || fail "Not saved: the two passwords were different.
Run scripts/set-admin-password and type the same one twice."
# Counted in characters by the locale here; the hasher counts again and has the last word.
((${#first} >= min_length)) || fail "Not saved: that's shorter than $min_length characters.
A long sentence you can remember works well. Run scripts/set-admin-password again."

# "Scrambled" in the words: plainer than "hashed", and as true.
echo "Scrambling the password (a few seconds)..."
hash=$(printf '%s\n' "$first" | hash_password) || fail "Not saved: scrambling it didn't work.
If a reason is shown above, fix that, or tell dev1 what it says (never the password).
Otherwise check DMbot's image is built (docker compose build web-api), then run
scripts/set-admin-password again."
first=""
second=""
# The hash's .env form is base64: letters, numbers, - _ and =. Anything else is an error
# message, not a hash.
[[ $hash =~ ^[A-Za-z0-9_=-]{40,}$ ]] || fail "Not saved: scrambling it didn't work.
Check DMbot's image is built (docker compose build web-api), then run
scripts/set-admin-password again."

umask 077
if [[ ! -f $env_file ]]; then
  cp "$example" "$env_file"
  echo "No .env yet, so I made one from .env.example."
fi
# Write a new copy next to .env, then swap it in, so .env is never left half-written.
# Like scripts/set-key: the new file is private (600) and owned by whoever runs this.
tmp=$(mktemp "$env_file.XXXXXX")
trap 'rm -f "$tmp"' EXIT
VALUE=$hash awk '
  BEGIN { prefix = "ADMIN_PASSWORD_HASH=" }
  index($0, prefix) == 1 { print prefix ENVIRON["VALUE"]; done = 1; next }
  { print }
  END { if (!done) print prefix ENVIRON["VALUE"] }
' "$env_file" >"$tmp"
chmod 600 "$tmp"
mv -f "$tmp" "$env_file"
trap - EXIT

echo "Saved. Only a scrambled form is in .env, never the password itself.
Next: step 3 (Google sign-in, optional) or step 4 of \"Turn on the admin page\" in
docs/DEPLOY.md."
