#!/usr/bin/env bash
# Puts one API key or token into the server's .env, so nobody has to edit .env by hand
# (painful from a phone over SSH). The key is pasted at a hidden prompt: it never goes
# into chat, the shell history, or the screen.
#
#   scripts/set-key                    pick from a numbered list
#   scripts/set-key DEEPGRAM_API_KEY   set that one
#
# Only the keys, tokens and secrets listed in .env.example can be set (names ending in
# _KEY, _TOKEN or _SECRET). Other settings are easy to read, so they belong in an editor.
# The new .env replaces the old file, so a symlinked .env becomes a plain file owned by
# whoever runs this.
#
# Tests point DMBOT_ENV_FILE, DMBOT_ENV_EXAMPLE and DMBOT_DOCKER at stand-ins, and set
# DMBOT_TEST_NO_TERMINAL to pipe the key in.
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
env_file=${DMBOT_ENV_FILE:-$root/.env}
example=${DMBOT_ENV_EXAMPLE:-$root/.env.example}
docker=${DMBOT_DOCKER:-docker}

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

[[ -f $example ]] || fail "Can't find .env.example in $root.
Get it back with: git checkout .env.example"

# Without a terminal the paste can't be hidden (ssh host scripts/set-key). Only the
# test-only switch skips this, so pointing DMBOT_ENV_FILE elsewhere doesn't (#811).
[[ -t 0 || -n ${DMBOT_TEST_NO_TERMINAL:-} ]] || fail "Log in to the server first, then run:
scripts/set-key"

# Every key, token and secret in .env.example, in file order.
mapfile -t choices < <(sed -nE 's/^([A-Z][A-Z0-9_]*(_KEY|_TOKEN|_SECRET))=.*/\1/p' "$example")

is_choice() {
  local k
  for k in "${choices[@]}"; do [[ $k == "$1" ]] && return 0; done
  return 1
}

current_value() {
  [[ -f $env_file ]] || return 0
  sed -nE "s/^$1=[\"']?([^\"']*)[\"']?$/\1/p" "$env_file" | tail -n 1
}

history_hint="If you typed a key on that line, wipe it from your history: history -c"

if [[ $# -gt 1 ]]; then
  fail "Not saved. Give only the setting name, like:
scripts/set-key DEEPGRAM_API_KEY
$history_hint"
elif [[ $# -eq 1 ]]; then
  # Never echo something that might be a pasted key.
  [[ $1 =~ ^[A-Za-z][A-Za-z0-9_]{2,40}$ ]] || fail "Not saved. That looks like a key, not a setting name.
Run scripts/set-key and paste the key only when asked.
$history_hint"
  name=${1^^}   # phones like to type lower case
else
  echo "Which key do you want to set?"
  for i in "${!choices[@]}"; do
    status="empty"
    [[ -n $(current_value "${choices[$i]}") ]] && status="set"
    printf '  %d) %s (%s)\n' "$((i + 1))" "${choices[$i]}" "$status"
  done
  pick=""
  read -r -p "Type a number and press Enter (just Enter cancels): " pick || true
  if [[ -z $pick ]]; then
    echo "Cancelled. Nothing was changed."
    exit 0
  fi
  if ! [[ $pick =~ ^[1-9][0-9]{0,2}$ ]] || ((pick > ${#choices[@]})); then
    fail "Not saved: pick a number from the list.
Run scripts/set-key to see it again."
  fi
  name=${choices[$((pick - 1))]}
fi

case $name in
  POSTGRES_ADMIN_PASSWORD | DMBOT_DB_PASSWORD)
    fail "Not saved: $name is a database password.
Changing it here would lock DMbot out of its saved data." ;;
esac
is_choice "$name" || fail "Not saved. $name isn't one of DMbot's keys.
Run scripts/set-key with no name to pick from a list.
For other settings, edit .env: nano $root/.env"

value=""
printf 'Paste the key for %s.\nYou won'"'"'t see it. Paste once, then press Enter: ' "$name"
read -r -s value || true
echo
# Pasting from a phone often adds spaces or a line ending.
value=${value//$'\r'/}
value=${value#"${value%%[![:space:]]*}"}
value=${value%"${value##*[![:space:]]}"}

[[ -n $value ]] || fail "Not saved: nothing was pasted.
Copy the key again, then run: scripts/set-key $name"
# Keys are letters, numbers and a few symbols. Anything else (spaces, quotes, $, #,
# invisible characters) means the paste picked up something extra, and Docker Compose
# would misread some of them.
[[ $value =~ ^[A-Za-z0-9._:/+=~-]+$ ]] || fail "Not saved: the paste has something keys don't have
(a space, quote, \$, # or a hidden character).
Copy only the key, then run: scripts/set-key $name"
((${#value} >= 8)) || fail "Not saved: that's too short for a key.
Copy the whole key, then run: scripts/set-key $name"

umask 077
if [[ $(current_value "$name") == "$value" ]]; then
  chmod 600 "$env_file"
  echo "$name already has that key. Nothing was changed."
  exit 0
fi

if [[ ! -f $env_file ]]; then
  cp "$example" "$env_file"
  echo "No .env yet, so I made one from .env.example.
Fill in the database passwords too: see docs/DEPLOY.md, step 3."
fi
# Write a new copy next to .env, then swap it in, so .env is never left half-written.
tmp=$(mktemp "$env_file.XXXXXX")
trap 'rm -f "$tmp"' EXIT
NAME=$name VALUE=$value awk '
  BEGIN { prefix = ENVIRON["NAME"] "=" }
  index($0, prefix) == 1 { print prefix ENVIRON["VALUE"]; done = 1; next }
  { print }
  END { if (!done) print prefix ENVIRON["VALUE"] }
' "$env_file" >"$tmp"
chmod 600 "$tmp"
mv -f "$tmp" "$env_file"
trap - EXIT

# The length makes a double paste easy to spot.
if ((${#value} >= 16)); then
  echo "Saved $name (${#value} characters, ends in ${value: -4})."
else
  echo "Saved $name (${#value} characters)."
fi

if [[ $name == SPEECHMATICS_API_KEY ]]; then
  echo "Bake-off runs read it fresh, so no restart is needed."
  exit 0
fi

# Offer a restart only when DMbot is already up here (or crash-looping, perhaps on a bad
# key), so this never starts a copy that was stopped on purpose: only one copy may be
# logged in to Discord at a time.
compose=("$docker" compose -f "$root/docker-compose.yml")
if command -v "$docker" >/dev/null \
  && "${compose[@]}" ps --status running --status restarting --services 2>/dev/null \
    | grep -qx core; then
  answer=""
  read -r -p "Restart DMbot now? It leaves voice for about a minute. [y/N] " answer || true
  if [[ $answer =~ ^[Yy] ]]; then
    "${compose[@]}" up -d core ears
    echo "Done. DMbot is using the new key."
    exit 0
  fi
fi
echo "Not restarted. If DMbot should be running, this makes it use the new key:
cd $root && docker compose up -d"
