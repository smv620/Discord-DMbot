#!/usr/bin/env bash
# Puts one API key or token into the server's .env, so nobody has to edit .env by hand
# (painful from a phone over SSH). The key is pasted at a hidden prompt: it never goes
# into chat, the shell history, or the screen.
#
#   scripts/set-key                    pick from a numbered list
#   scripts/set-key DEEPGRAM_API_KEY   set that one
#
# Only settings listed in .env.example can be set. The database passwords are refused:
# Postgres keeps the old one, so changing .env alone would lock DMbot out of its data.
# Tests point DMBOT_ENV_FILE and DMBOT_ENV_EXAMPLE at temporary files.
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
env_file=${DMBOT_ENV_FILE:-$root/.env}
example=${DMBOT_ENV_EXAMPLE:-$root/.env.example}

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

[[ -f $example ]] || fail "Can't find $example. Run this from your DMbot folder."

# Every setting name in .env.example, in file order.
mapfile -t known < <(sed -nE 's/^([A-Z][A-Z0-9_]*)=.*/\1/p' "$example")

is_known() {
  local k
  for k in "${known[@]}"; do [[ $k == "$1" ]] && return 0; done
  return 1
}

current_value() {
  [[ -f $env_file ]] || return 0
  sed -nE "s/^$1=(.*)$/\1/p" "$env_file" | tail -n 1
}

if [[ $# -gt 1 ]]; then
  fail "Give one setting name, for example: scripts/set-key DEEPGRAM_API_KEY"
elif [[ $# -eq 1 ]]; then
  name=${1^^}   # phones like to type lower case
else
  # The settings that hold keys, tokens and secrets.
  choices=()
  for k in "${known[@]}"; do
    [[ $k =~ (_KEY|_TOKEN|_SECRET)$ ]] && choices+=("$k")
  done
  echo "Which key do you want to set?"
  for i in "${!choices[@]}"; do
    status="empty"
    [[ -n $(current_value "${choices[$i]}") ]] && status="set"
    printf '  %d) %s (%s)\n' "$((i + 1))" "${choices[$i]}" "$status"
  done
  read -r -p "Type a number, then press Enter: " pick
  if ! [[ $pick =~ ^[1-9][0-9]*$ ]] || ((pick < 1 || pick > ${#choices[@]})); then
    fail "That isn't one of the numbers. Nothing was changed."
  fi
  name=${choices[$((pick - 1))]}
fi

case $name in
  POSTGRES_ADMIN_PASSWORD | DMBOT_DB_PASSWORD)
    fail "$name can't be changed here: the database still has the old password, so DMbot
would lose its data. Nothing was changed." ;;
esac
is_known "$name" || fail "$name isn't a DMbot setting (it's not in .env.example). Check the
spelling, or run scripts/set-key with no name to pick from a list. Nothing was changed."

read -r -s -p "Paste the value for $name (it stays hidden), then press Enter: " value
echo
# Pasting from a phone often adds spaces or a line ending.
value=${value//$'\r'/}
value=${value#"${value%%[![:space:]]*}"}
value=${value%"${value##*[![:space:]]}"}

[[ -n $value ]] || fail "Nothing was pasted. Nothing was changed."
# Docker Compose reads $ and # in .env specially, and quotes or spaces usually mean the
# paste picked up something extra.
if [[ $value =~ [[:space:]\'\"\`\$\\#] ]]; then
  fail "That has a space, quote, \$, \\ or # in it, which keys don't have. Copy just the
key and try again. Nothing was changed."
fi
((${#value} >= 8)) || fail "That's too short to be a key. Copy the whole key and try again.
Nothing was changed."

if [[ $(current_value "$name") == "$value" ]]; then
  echo "$name already has that value. Nothing was changed."
  exit 0
fi

# Write a new copy next to .env, then swap it in, so .env is never left half-written.
umask 077
if [[ ! -f $env_file ]]; then
  cp "$example" "$env_file"
  echo "No .env yet, so I made one from .env.example."
fi
tmp=$(mktemp "$env_file.XXXXXX")
trap 'rm -f "$tmp"' EXIT
NAME=$name VALUE=$value awk '
  BEGIN { prefix = ENVIRON["NAME"] "=" }
  index($0, prefix) == 1 { print prefix ENVIRON["VALUE"]; done = 1; next }
  { print }
  END { if (!done) print prefix ENVIRON["VALUE"] }
' "$env_file" >"$tmp"
chmod 600 "$tmp"
mv -f "$tmp" "$env_file"
trap - EXIT

if ((${#value} >= 16)); then
  echo "Saved $name (ends in ${value: -4})."
else
  echo "Saved $name."
fi

# Offer a restart only when DMbot is already running here, so this never starts a
# second copy (only one copy may be logged in to Discord at a time).
if [[ -t 0 ]] && command -v docker >/dev/null \
  && docker compose -f "$root/docker-compose.yml" ps --status running --services 2>/dev/null \
    | grep -qx core; then
  read -r -p "Restart DMbot now so it uses the new value? [y/N] " answer
  if [[ $answer =~ ^[Yy] ]]; then
    docker compose -f "$root/docker-compose.yml" up -d core ears
    echo "Restarted."
    exit 0
  fi
fi
echo "DMbot uses it after the next restart: docker compose up -d"
