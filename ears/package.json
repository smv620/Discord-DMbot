{
  "name": "dmbot-ears",
  "version": "0.1.0",
  "private": true,
  "description": "DMbot voice service: per-speaker capture from the table voice channel, streamed to the Python core.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "dev": "tsx --env-file-if-exists=../.env src/index.ts"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.16.0",
    "prism-media": "^1.3.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0"
  }
}
