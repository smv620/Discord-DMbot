# A shared recap's address holds its secret (#2119): never cached, never listed, and never sent on to
# another site as a referrer. Cloudflare adds a matching rule's headers to the sitewide ones, so the
# sitewide Referrer-Policy is detached first.
/r/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
  ! Referrer-Policy
  Referrer-Policy: no-referrer
