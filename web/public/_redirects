# The recap email links to /account/recaps/<id>. The site has one recaps page; this serves it
# for every id (a rewrite, status 200, so the address stays) and the page reads the id from
# the address (#1386).
/account/recaps/*  /account/recaps  200

# The homebrew pages (#1525): one page for the list and a campaign; it reads which from the address.
/account/homebrew/*  /account/homebrew  200
# The house-rules pages (#1521): one page for the list and a campaign; it reads which from the address.
/account/house-rules/*  /account/house-rules  200

# The transcript pages (#1501): one page for the list, a campaign and a session; it reads which
# from the address.
/account/transcripts/*  /account/transcripts  200

# The Import sessions page (#2107): one page for every campaign; it reads which from the address.
/account/import/*  /account/import  200

# A shared recap (#2119): one page for every link; it reads the secret from the address.
# /r/ itself and /r/<secret> both get the page; the page reads the secret from the address.
/r/*  /r  200
