---
import PicturesIsland from "../../account/PicturesIsland";
import { picturesPage } from "../../content/pictures-words";
import Base from "../../layouts/Base.astro";
import "../../styles/account.css";
---

<Base
  title="Pictures"
  description="The pictures people posted in your table's chat, and the links to them."
  noindex
>
  <div class="account">
    <h1>{picturesPage.heading}</h1>
    <PicturesIsland client:load />
    <noscript>
      <p>This page needs JavaScript to show the pictures. Turn it on, then reload the page.</p>
    </noscript>
  </div>
</Base>
