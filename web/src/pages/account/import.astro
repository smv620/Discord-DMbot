---
import ImportIsland from "../../account/ImportIsland";
import { IMPORT_LIVE, importPage } from "../../content/import-words";
import Base from "../../layouts/Base.astro";
import "../../styles/account.css";
---

<Base
  title="Import sessions"
  description="Bring in sessions DMbot didn't record, from text files."
  noindex
>
  <div class="account">
    <h1>{importPage.heading}</h1>
    {IMPORT_LIVE ? <ImportIsland client:load /> : <p>This page isn't open yet.</p>}
    <noscript>
      <p>This page needs JavaScript to import sessions. Turn it on, then reload the page.</p>
    </noscript>
  </div>
</Base>
