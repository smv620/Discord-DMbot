---
import RecapsIsland from "../../account/RecapsIsland";
import { text } from "../../content/recaps";
import Base from "../../layouts/Base.astro";
import "../../styles/account.css";
---

<Base
  title="Your recaps"
  description="Read, change and post the recap DMbot wrote after your session."
  noindex
>
  <div class="account">
    <h1>{text.heading}</h1>
    <RecapsIsland client:load />
    <noscript>
      <p>This page needs JavaScript to show your recaps. Turn it on, then reload the page.</p>
    </noscript>
  </div>
</Base>
