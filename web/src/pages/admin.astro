---
// The admin page (#772): never linked from the site, kept out of search engines (here and
// by X-Robots-Tag in public/_headers), and drawn only in the browser.
import { text } from "../content/admin";
import AdminIsland from "../admin/AdminIsland";
import Base from "../layouts/Base.astro";
---

<Base title={text.title} description={text.description} noindex nofollow>
  <div class="admin">
    <h1>{text.heading}</h1>
    <noscript><p>{text.needsScript}</p></noscript>
    <AdminIsland client:only="preact" />
  </div>
</Base>

<style>
  .admin {
    max-width: var(--text-width);
  }

  .admin :global(.stack),
  .admin :global(fieldset) {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .admin :global(.stack > *),
  .admin :global(fieldset > *) {
    margin: 0;
  }

  .admin :global(fieldset) {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .admin :global(label) {
    font-weight: 600;
  }

  .admin :global(input) {
    width: 100%;
    box-sizing: border-box;
    min-height: var(--tap);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    font: inherit;
  }

  .admin :global(.button) {
    align-self: flex-start;
  }

  .admin :global(button.button) {
    border: 0;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .admin :global(.button.secondary) {
    background: transparent;
    color: var(--accent);
    border: 2px solid var(--accent);
  }

  .admin :global(.button:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .admin :global(.warn) {
    padding: var(--space-4);
    border-radius: var(--radius);
    background: var(--warn-soft);
    border: 1px solid var(--warn);
  }

  .admin :global(.ok) {
    color: var(--accent);
    font-weight: 600;
  }
</style>
