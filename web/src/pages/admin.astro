---
// The admin page (#772): never linked from the site, kept out of search engines (here and
// by X-Robots-Tag in public/_headers), and drawn only in the browser.
import { text } from "../content/admin";
import AdminIsland from "../admin/AdminIsland";
import Base from "../layouts/Base.astro";
---

<Base title={text.title} description={text.description} noindex nofollow>
  <div class="admin">
    <h1 id="admin-heading" tabindex="-1">{text.heading}</h1>
    <noscript><p>{text.needsScript}</p></noscript>
    <AdminIsland client:only="preact" />
  </div>
</Base>

<style>
  .admin {
    max-width: var(--text-width);
  }

  .admin :global(.stack),
  .admin :global(fieldset) {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .admin :global(.stack > *),
  .admin :global(fieldset > *) {
    margin: 0;
  }

  .admin :global(fieldset) {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .admin :global(label) {
    font-weight: 600;
  }

  .admin :global(input),
  .admin :global(select) {
    width: 100%;
    box-sizing: border-box;
    min-height: var(--tap);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--control-edge);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    font: inherit;
  }

  .admin :global(.button) {
    align-self: flex-start;
  }

  .admin :global(button.button) {
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .admin :global(.button.secondary) {
    background: transparent;
    color: var(--accent);
    border: 1px solid var(--control-edge); /* 3:1, so the button's edge can be seen (#1806) */
    font-weight: 500;
  }

  .admin :global(.button.secondary:hover:not(:disabled)) {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .admin :global(.button:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .admin :global(.warn) {
    padding: var(--space-4);
    border-radius: var(--radius);
    background: var(--warn-soft);
    border: 1px solid var(--warn);
  }

  .admin :global(.grants),
  .admin :global(.tickets),
  .admin :global(.history) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* Recent changes (#2199): a window of fixed height, so the box never grows or shrinks as the
     pages change; a long page scrolls inside it. */
  .admin :global(.history-window) {
    height: 24rem;
    overflow-y: auto;
    padding: var(--space-3);
    border: 1px solid var(--control-edge);
    border-radius: var(--radius);
  }

  /* Wide: one row, Newest Newer [Page n of N Go] Older Oldest. Narrow: the jump box on a row of
     its own, then the four buttons in a grid, so Newer and Older never end up apart. */
  .admin :global(.page-bar) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  @media (max-width: 40rem) {
    .admin :global(.page-bar) {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .admin :global(.page-jump) {
      grid-column: 1 / -1;
      grid-row: 1;
    }
  }

  .admin :global(.page-bar .button) {
    align-self: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    min-width: var(--tap);
    min-height: var(--tap);
    padding-inline: var(--space-3);
  }

  /* Read by a screen reader (the page number is announced) but not shown: the bar's own
     "Page n of N" says it already. */
  .admin :global(.visually-hidden) {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .admin :global(.page-jump) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .admin :global(.page-jump input[type="text"]) {
    width: 4rem;
    padding-inline: var(--space-2);
    text-align: center;
  }

  .admin :global(.grants li),
  .admin :global(.tickets li) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow-wrap: anywhere;
  }

  /* A ticket's words keep the person's own line breaks. */
  .admin :global(.ticket-text) {
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .admin :global(.row) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .admin :global(.ok) {
    color: var(--accent);
    font-weight: 600;
  }
</style>
