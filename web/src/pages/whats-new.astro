---
import EntryList from "../components/EntryList.astro";
import Base from "../layouts/Base.astro";
import { entries, olderHeading, splitEntries, whatsNewHeading, whatsNewIntro } from "../content/whats-new";

// The newest entries only (the last 60 days, at least 30): the page lists what is live, so it would grow with every one (#4200).
const { recent, older } = splitEntries(entries, new Date());
---

<Base
  title={whatsNewHeading}
  description="What is new in DMbot, newest first, in plain words."
>
  <h1>{whatsNewHeading}</h1>
  <p class="lead muted">{whatsNewIntro}</p>

  <EntryList entries={recent} />

  {older.length > 0 && <p><a href="/whats-new/older">{olderHeading}</a></p>}

  <p class="muted">
    Need a hand? Read the <a href="/help">Help page</a>.
  </p>
</Base>
