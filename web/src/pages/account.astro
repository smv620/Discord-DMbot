---
import AccountIsland from "../account/AccountIsland";
import { text } from "../content/account";
import Base from "../layouts/Base.astro";
---

<Base
  title="My account"
  description="Sign in with Discord to see your plan, your hours and your campaigns."
  noindex
>
  <div class="account">
    <h1>{text.heading}</h1>
    <AccountIsland client:load />
    <noscript>
      <p>This page needs JavaScript to show your account. Turn it on, then reload the page.</p>
    </noscript>
  </div>
</Base>

<style>
  .account {
    max-width: var(--text-width);
  }

  .account :global(.stack) {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .account :global(.stack > *),
  .account :global(.panel p),
  .account :global(.stack > p) {
    margin: 0;
  }

  .account :global(.lead) {
    font-size: var(--text-lg);
  }

  .account :global(.small) {
    font-size: var(--text-sm);
  }

  .account :global(.panel) {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .account :global(.panel h2) {
    font-size: var(--text-lg);
    margin: 0;
  }

  .account :global(.warn),
  .account :global(.warn-box) {
    padding: var(--space-4);
    border-radius: var(--radius);
    background: var(--warn-soft);
    border: 1px solid var(--warn);
  }

  .account :global(.warn-box) {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .account :global(.ok) {
    color: var(--accent);
    font-weight: 600;
  }

  .account :global(.hello) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .account :global(button.link) {
    min-height: var(--tap);
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  .account :global(button.button) {
    border: 0;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .account :global(.button) {
    align-self: flex-start;
  }

  .account :global(.button.secondary) {
    background: transparent;
    color: var(--accent);
    border: 2px solid var(--accent);
  }

  .account :global(.button.danger) {
    background: var(--danger);
    color: var(--accent-text);
  }

  .account :global(.button:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .account :global(.plan-name) {
    font-size: var(--text-xl);
    font-weight: 700;
  }

  .account :global(.hours-line) {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .account :global(progress) {
    width: 100%;
    height: 0.75rem;
    accent-color: var(--accent);
  }

  .account :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .account :global(.choices ul li),
  .account :global(.servers li) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border);
  }

  .account :global(.campaigns li) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .account :global(.campaigns li:last-child),
  .account :global(.servers li:last-child) {
    border-bottom: 0;
  }

  .account :global(.campaign-name) {
    font-weight: 600;
  }

  .account :global(.tags) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .account :global(.tag) {
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    background: var(--accent-soft);
    font-size: var(--text-sm);
  }

  .account :global(.tag.paused) {
    background: var(--warn-soft);
  }

  .account :global(fieldset) {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .account :global(legend) {
    font-weight: 600;
    padding: 0;
    margin-bottom: var(--space-2);
  }

  .account :global(.choice) {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap);
  }

  .account :global(.choice input) {
    width: 1.25rem;
    height: 1.25rem;
    accent-color: var(--accent);
  }

  .account :global(.handover) {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .account :global(.row) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .account :global(.danger h2) {
    color: var(--danger);
  }
</style>
