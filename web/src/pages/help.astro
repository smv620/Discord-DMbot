---
import Base from "../layouts/Base.astro";
import { RECAPS_LIVE, recapsHeading } from "../content/recap-words";
import { recapSteps, accountSteps, dmSteps, quickAnswers, quickAnswersHeading, snags, snagsHeading, emailNote, emailSteps, gettingHelp, helpHeading, helpIntro, playerNote, playerSteps } from "../content/help";
---

<Base
  title="Help"
  description="How to use DMbot in Discord, step by step, for game masters and players."
>
  <h1>{helpHeading}</h1>
  <p class="lead muted">{helpIntro}</p>
  <p class="muted">
    Looking for something new? See <a href="/whats-new">what's new</a>. Need more help? See{" "}
    <a href={`#${gettingHelp.id}`}>getting help</a>.
  </p>

  <section aria-labelledby="dm-heading">
    <h2 id="dm-heading">For the game master</h2>
    <ol>
      {
        dmSteps.map((s) => (
          <li>
            {s.text}
            {s.text.startsWith("Add DMbot") && (
              <>
                {" "}
                <a href="/install">Add to Discord</a>
              </>
            )}
          </li>
        ))
      }
    </ol>
    <h3 id="quick-heading">{quickAnswersHeading}</h3>
    <ul aria-labelledby="quick-heading">
      {quickAnswers.map((s) => <li>{s.text}</li>)}
    </ul>
    {
      RECAPS_LIVE && (
        <>
          <h3 id="recaps-heading">{recapsHeading}</h3>
          <ul aria-labelledby="recaps-heading">
            {recapSteps.map((s) => (
              <li>{s.text}</li>
            ))}
          </ul>
        </>
      )
    }
  </section>

  <section aria-labelledby="player-heading">
    <h2 id="player-heading">For players</h2>
    <ol>
      {
        playerSteps.map((s) => (
          <li>
            {s.text}
            {s.link && (
              <>
                {" "}
                <a href={s.link.href}>{s.link.text}</a>
              </>
            )}
          </li>
        ))
      }
    </ol>
    <p class="muted">{playerNote}</p>
  </section>

  <section aria-labelledby="account-heading">
    <h2 id="account-heading">Your account</h2>
    <ol>
      {
        accountSteps.map((s) => (
          <li>
            {s.text.startsWith("Forgot") ? (
              <>
                {s.text.split("open the Discord sign-in page")[0]}open the{" "}
                <a href="https://discord.com/login" rel="noopener noreferrer">Discord sign-in page</a>
                {s.text.split("open the Discord sign-in page")[1]}
              </>
            ) : s.text.includes("your account page") ? (
              <>
                {s.text.split("your account page")[0]}
                <a href="/account">your account page</a>
                {s.text.split("your account page")[1]}
              </>
            ) : (
              s.text
            )}
            {s.link && (
              <>
                {" "}
                <a href={s.link.href} rel="noopener noreferrer">{s.link.text}</a>
              </>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="emails-heading">
    <h2 id="emails-heading">Emails from DMbot</h2>
    <ol>
      {emailSteps.map((s) => <li>{s.text}</li>)}
    </ol>
    <p class="muted">{emailNote}</p>
  </section>

  <section aria-labelledby="snags-heading" id="snags">
    <h2 id="snags-heading">{snagsHeading}</h2>
    <ol>
      {
        snags.map((s) => (
          <li>
            <strong>{s.question}</strong>
            <br />
            {s.text}
            {s.link && (
              <>
                {" "}
                <a href={s.link.href}>{s.link.text}</a>.
              </>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="getting-help-heading" id={gettingHelp.id}>
    <h2 id="getting-help-heading">{gettingHelp.heading}</h2>
    <ol>
      {
        gettingHelp.items.map((item) => (
          <li>
            <strong>{item.lead}</strong>{" "}
            {item.parts.map((part) =>
              typeof part === "string" ? part : <a href={part.href}>{part.text}</a>,
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <p class="muted">
    Stuck? <a href="/hello">Say hello</a> and tell us what you saw.
  </p>
</Base>

<style>
  ol {
    max-width: var(--text-width);
    padding-left: var(--space-6);
  }

  li {
    margin-bottom: var(--space-4);
  }

  section {
    margin-top: var(--space-8);
  }
</style>
