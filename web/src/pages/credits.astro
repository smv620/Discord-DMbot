---
import Base from "../layouts/Base.astro";
import {
  creditsHeading,
  creditsIntro,
  creditsNotAffiliated,
  sources,
  whatDmbotDid,
} from "../content/credits";

// The statements are shown word for word; only the web addresses inside them become links.
const parts = (text: string): { text: string; href?: string }[] =>
  text
    .split(/(https?:\/\/[^\s]+?)(?=[.,;)]*(?:\s|$))/)
    .filter((p) => p !== "")
    .map((p) => (p.startsWith("http") ? { text: p, href: p } : { text: p }));
---

<Base
  title={creditsHeading}
  description="Where DMbot's rules text comes from, and the licence it is shared under."
>
  <h1>{creditsHeading}</h1>
  <p class="lead muted">{creditsIntro}</p>
  <p>{whatDmbotDid}</p>

  {
    sources.map((s) => (
      <section class="surface source">
        <h2>{s.name}</h2>
        <p>
          {parts(s.statement).map((p) =>
            p.href ? <a href={p.href}>{p.text}</a> : p.text,
          )}
        </p>
        <p class="muted">
          The changes DMbot made are listed in <a href={s.file}>the attribution file on GitHub</a>.
        </p>
      </section>
    ))
  }

  <p class="muted">{creditsNotAffiliated}</p>
</Base>

<style>
  .source {
    padding: var(--space-6);
    margin: var(--space-4) 0;
  }

  .source h2 {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-2);
  }

  .source p {
    overflow-wrap: anywhere;
  }
</style>
