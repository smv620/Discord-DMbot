---
import Base from "../layouts/Base.astro";
import { beforeHeading, beforeQuestions } from "../content/before-you-start";
import { features, featuresHeading } from "../content/features";
---

<Base
  title="DMbot"
  description="DMbot listens to your table in Discord and quietly helps the game master. For 5e-compatible tabletop games."
>
  <section class="hero">
    <h1>Your table talks. DMbot listens and helps the game master (DM).</h1>
    <p class="lead muted">
      It writes down what was said, remembers the names your table makes up, and gives the game
      master quiet tips. It never makes up the story and never decides. Only players who say yes
      are recorded. For 5e-compatible tabletop games.
    </p>
    <a class="button" href="/install">Add DMbot to Discord</a>
    <p class="questions">
      <a href="/pricing#questions">Questions about plans and hours? Read the answers.</a>
    </p>
  </section>

  <section aria-labelledby="does-heading" class="does">
    <h2 id="does-heading">{featuresHeading}</h2>
    <div class="features">
      {
        features.map((f) => (
          <article class="surface feature">
            <h3>{f.title}</h3>
            <p>{f.what}</p>
            <p class="muted example">{f.example}</p>
          </article>
        ))
      }
    </div>
    <p class="more"><a href="/how-it-works">See how the helpers work together.</a></p>
  </section>

  <section aria-labelledby="before-heading" class="before">
    <h2 id="before-heading">{beforeHeading}</h2>
    {
      beforeQuestions.map((item, i) => (
        <details open={i === 0}>
          <summary>{item.question}</summary>
          <p>
            {item.answer}
            {item.more && (
              <>
                {" "}
                <a href={item.more.href}>{item.more.text}</a>
              </>
            )}
          </p>
        </details>
      ))
    }
  </section>
</Base>

<style>
  /* On a 360 x 640 phone the main button must show without scrolling (#559). */
  .hero {
    max-width: var(--text-width);
    padding-bottom: var(--space-8);
  }

  @media (min-width: 48rem) {
    .hero {
      padding-top: var(--space-8);
    }

    .lead {
      font-size: var(--text-lg);
    }
  }

  .questions {
    margin-top: var(--space-4);
  }

  .questions a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }

  .features {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  @media (min-width: 48rem) {
    .features {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .feature {
    padding: var(--space-6);
  }

  .does h2 {
    margin-top: var(--space-8);
  }

  .feature h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .feature p {
    margin: 0;
  }

  .example {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }

  /* "Before you start": the same open-and-close rows as the plan questions on /pricing. */
  .before {
    max-width: var(--text-width);
  }

  .before h2 {
    margin-top: var(--space-8);
  }

  details {
    border-bottom: 1px solid var(--border);
  }

  summary {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    padding-block: var(--space-2);
    justify-content: space-between;
    gap: var(--space-4);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: "+" / "";
    flex: none;
    font-size: var(--text-xl);
    line-height: 1;
    color: var(--accent);
  }

  details[open] summary::after {
    content: "\2212" / "";
  }

  details p {
    margin: 0 0 var(--space-4);
  }
</style>
