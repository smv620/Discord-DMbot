---
import Base from "../layouts/Base.astro";
---

<Base
  title="DMbot"
  description="DMbot listens to your table in Discord and quietly helps the game master. For 5e-compatible tabletop games."
>
  <section class="hero">
    <h1>Your table talks. DMbot listens and helps the game master.</h1>
    <p class="lead muted">
      It writes down what was said, remembers the names your table makes up, and gives the game
      master quiet tips. It never makes up story and never decides. For 5e-compatible tabletop
      games.
    </p>
    <a class="button" href="/install">Add DMbot to Discord</a>
    <p class="note muted">Placeholder page. The real words come in a later update.</p>
  </section>
</Base>

<style>
  .hero {
    max-width: var(--text-width);
    padding-block: var(--space-8);
  }

  .lead {
    font-size: var(--text-lg);
  }

  .note {
    margin-top: var(--space-8);
    font-size: var(--text-sm);
  }
</style>
