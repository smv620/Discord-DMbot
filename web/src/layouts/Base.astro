---
// The one layout every page uses: head tags, header with the menu, footer with the legal links.
import "../styles/global.css";

interface Props {
  /** Page name shown in the browser tab, before " · DMbot". */
  title: string;
  /** One plain sentence for search results and link previews. */
  description: string;
  /** Keep the page out of search results (the signed-in area). */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const fullTitle = title === "DMbot" ? title : `${title} · DMbot`;
// Built pages see their file name ("/pricing.html", "/index.html"); links don't have it.
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, "") || "/";

// Each item is a button-shaped link with a small icon (#558), so it looks clickable. The
// icons are our own simple line drawings (24 x 24, drawn with currentColor) and hidden
// from screen readers: the words are the label.
const menu = [
  { href: "/pricing", label: "Prices", icon: "M3 12V4h8l10 10-8 8L3 12Zm5-4.5h.01" },
  {
    href: "/pricing#questions",
    label: "Q&A",
    icon: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm-2.5-11.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6V14m0 3h.01",
  },
  {
    href: "/install",
    label: "Add to Discord",
    icon: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-13v8m-4-4h8",
  },
  {
    href: "/account",
    label: "My Account",
    icon: "M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-8 9a8 8 0 0 1 16 0",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the page</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/">
          <svg class="mark" viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false">
            <rect width="32" height="32" rx="8" fill="currentColor" />
            <path class="mark-letter" d="M10 9h6a7 7 0 0 1 0 14h-6z" fill="none" stroke-width="3" />
          </svg>
          DMbot
        </a>
        <nav aria-label="Main">
          <ul>
            {
              menu.map((item) => (
                <li>
                  <a href={item.href} aria-current={path === item.href ? "page" : undefined}>
                    <svg
                      class="icon"
                      viewBox="0 0 24 24"
                      width="18"
                      height="18"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path d={item.icon} />
                    </svg>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="muted">
          DMbot helps the game master run 5e-compatible tabletop games. It never decides; the game
          master does.
        </p>
        <ul>
          <li><a href="/legal/terms">Terms of use</a></li>
          <li><a href="/legal/privacy">Privacy</a></li>
          <li><a href="/legal/refunds">Refunds</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--space-2);
    top: -10rem;
    padding: var(--space-2) var(--space-4);
    background: var(--surface);
    border-radius: var(--radius);
  }

  .skip:focus {
    top: var(--space-2);
  }

  .site-header {
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 85%, transparent);
    box-shadow: var(--shadow);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-2);
  }

  .brand {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .mark {
    flex: none;
    color: var(--accent);
  }

  .mark-letter {
    stroke: var(--accent-text);
  }

  nav ul,
  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }

  nav ul {
    gap: var(--space-2);
  }

  /* Menu items look like buttons: a border, a soft fill and an icon (#558). */
  nav a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    padding-inline: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }

  nav a:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  nav a[aria-current="page"] {
    border-color: var(--accent);
    background: var(--accent-soft);
    box-shadow: inset 0 -3px 0 var(--accent);
  }

  .icon {
    flex: none;
    color: var(--accent);
  }

  main {
    flex: 1;
    padding-block: var(--space-6) var(--space-12);
  }

  @media (min-width: 48rem) {
    main {
      padding-top: var(--space-8);
    }
  }

  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding-block: var(--space-6);
    font-size: var(--text-sm);
  }

  .site-footer a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }
</style>
