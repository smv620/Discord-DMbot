---
// The one layout every page uses: head tags, header with the menu, footer with the legal links.
import "../styles/global.css";
import "../styles/transitions.css";

interface Props {
  /** Page name shown in the browser tab, before " · DMbot". */
  title: string;
  /** One plain sentence for search results and link previews. */
  description: string;
  /** Keep the page out of search results (the signed-in area). */
  noindex?: boolean;
  /** Also ask search engines not to follow its links (the admin page). */
  nofollow?: boolean;
  /** No page-change effect into or out of this page (the legal pages, #1289). */
  plain?: boolean;
  /** The canonical link and the share tags are built from the built page's own path, never from the
   * address in the browser: a shared recap's secret must not be put in them (#2119).
   * No menu and no footer: a page for someone who was only sent a link (a shared recap, #2119). */
  bare?: boolean;
}

const { title, description, noindex = false, nofollow = false, plain = false, bare = false } = Astro.props;
const fullTitle = title === "DMbot" ? title : `${title} · DMbot`;

// Built pages see their file name ("/pricing.html", "/index.html"); links don't have it.
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, "") || "/";

// Link previews (Discord, chat apps) need full addresses, so these come from the configured
// site (astro.config.mjs), never from the address the page happens to be served at.
const origin = Astro.site ?? new URL("https://getdmbot.com");
const canonical = new URL(path, origin).href;
const shareImage = new URL("/share.png", origin).href;

// Each item is a button-shaped link with a small icon (#558), so it looks clickable. The
// icons are our own simple line drawings (24 x 24, drawn with currentColor) and hidden
// from screen readers: the words are the label.
const menu = [
  { href: "/pricing", label: "Prices", icon: "M3 12V4h8l10 10-8 8L3 12Zm5-4.5h.01" },
  {
    href: "/pricing#questions",
    label: "Q&A",
    icon: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm-2.5-11.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6V14m0 3h.01",
  },
  {
    href: "/help",
    label: "Help",
    icon: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm-3-12h6v6H9z",
  },
  {
    href: "/install",
    label: "Add to Discord",
    icon: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-13v8m-4-4h8",
  },
  {
    href: "/account",
    label: "My Account",
    icon: "M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-8 9a8 8 0 0 1 16 0",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content={nofollow ? "noindex, nofollow" : "noindex"} />}
    <link rel="canonical" href={canonical} />
    {
      /* Page changes (#1289). A change between two pages is animated only when BOTH opt in, so
         a plain page (the legal ones) makes the change into and out of it a plain change. Only
         people who haven't asked for less motion opt in; src/styles/transitions.css has the
         rest. Inline, so it can differ page by page; styles are allowed inline by the CSP. */
      plain ? (
        <style is:inline set:html="@view-transition{navigation:none}h1{view-transition-name:none}" />
      ) : (
        <style
          is:inline
          set:html="@media (prefers-reduced-motion:no-preference){@view-transition{navigation:auto}}"
        />
      )
    }
    <meta property="og:site_name" content="DMbot" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content="DMbot: a quiet helper for the game master" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the page</a>
    {!bare && (<header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/">
          <svg class="mark" viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false">
            <rect width="32" height="32" rx="8" fill="currentColor" />
            <path class="mark-letter" d="M10 9h6a7 7 0 0 1 0 14h-6z" fill="none" stroke-width="3" />
          </svg>
          DMbot
        </a>
        <nav aria-label="Main">
          <ul>
            {
              menu.map((item) => (
                <li>
                  <a href={item.href} aria-current={path === item.href ? "page" : undefined}>
                    <svg
                      class="icon"
                      viewBox="0 0 24 24"
                      width="18"
                      height="18"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path d={item.icon} />
                    </svg>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>)}
    <main id="main" class="wrap">
      <slot />
    </main>
    {!bare && (<footer class="site-footer">
      <div class="wrap">
        <p class="muted">
          DMbot helps the game master run 5e-compatible tabletop games. It never decides; the game
          master does.
        </p>
        <ul>
          <li><a href="/legal/terms">Terms of use</a></li>
          <li><a href="/legal/privacy">Privacy</a></li>
          <li><a href="/legal/refunds">Refunds</a></li>
          <li><a href="/credits">Credits</a></li>
          <li><a href="/how-it-works">How it works</a></li>
          <li><a href="/players">For players</a></li>
          <li><a href="/help#getting-help">Get help</a></li>
          <li><a href="/whats-new">What's new</a></li>
          <li><a href="/hello">Say hello</a></li>
        </ul>
      </div>
    </footer>)}
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--space-2);
    top: -10rem;
    padding: var(--space-2) var(--space-4);
    background: var(--surface);
    border-radius: var(--radius);
  }

  .skip:focus {
    top: var(--space-2);
    display: inline-flex;
    align-items: center;
    min-height: var(--tap); /* a thumb-sized target, like the buttons (#1806) */
  }

  .site-header {
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 85%, transparent);
    box-shadow: var(--shadow);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-2);
  }

  .brand {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .mark {
    flex: none;
    color: var(--accent);
  }

  .mark-letter {
    stroke: var(--accent-text);
  }

  nav ul,
  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }

  nav ul {
    gap: var(--space-2);
  }

  /* Menu items look like buttons: a border, a soft fill and an icon (#558). */
  nav a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    padding-inline: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }

  nav a:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  nav a[aria-current="page"] {
    border-color: var(--accent);
    background: var(--accent-soft);
    box-shadow: inset 0 -3px 0 var(--accent);
  }

  .icon {
    flex: none;
    color: var(--accent);
  }

  main {
    flex: 1;
    padding-block: var(--space-6) var(--space-12);
  }

  @media (min-width: 48rem) {
    main {
      padding-top: var(--space-8);
    }
  }

  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding-block: var(--space-6);
    font-size: var(--text-sm);
  }

  .site-footer a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }
</style>
