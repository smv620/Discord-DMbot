---
// The list of What's new entries, one card each, used by the main page and the older page (#4200).
import { formatDate, type Entry } from "../content/whats-new";

interface Props {
  entries: Entry[];
}
const { entries } = Astro.props;
---

<ol class="entries">
  {
    entries.map((e) => (
      <li class="surface entry">
        <h2>{e.title}</h2>
        <p class="muted date">
          <time datetime={e.date}>{formatDate(e.date)}</time>
        </p>
        <p>{e.what}</p>
      </li>
    ))
  }
</ol>

<style>
  .entries {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0;
    display: grid;
    gap: var(--space-4);
  }

  .entry {
    padding: var(--space-6);
  }

  .entry h2 {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-1);
  }

  .entry p {
    margin: 0;
  }

  .entry .date {
    margin-bottom: var(--space-2);
  }
</style>
