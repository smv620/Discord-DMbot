{
  "name": "dmbot-web",
  "version": "0.1.0",
  "private": true,
  "description": "DMbot customer website: static pages and one small signed-in area.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/csp-hashes.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "vitest run",
    "check:links": "node scripts/check-links.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:transitions": "node scripts/check-transitions.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:phone": "node scripts/check-phone.mjs",
    "check:smoke": "node scripts/check-smoke.mjs",
    "check:weight": "node scripts/check-weight.mjs",
    "check:golive": "node scripts/check-golive.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.6",
    "astro": "~7.3.5",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^22.20.5",
    "axe-core": "^4.14.0",
    "happy-dom": "^20.14.5",
    "playwright-core": "1.63.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
