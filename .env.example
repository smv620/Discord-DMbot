# Copy to .env and fill in. Never commit .env.
# On the server, run scripts/set-key to add a key without editing this file (easy from a phone).

# Discord bot token (Discord Developer Portal → your app → Bot → Reset Token)
DISCORD_TOKEN=

# Your private test server's ID (right-click server → Copy Server ID, with Developer Mode on).
# Optional, for development. Commands are always registered for every server; this also
# copies them here so changes show up instantly (expect each command twice in this server).
DISCORD_DEV_GUILD_ID=
# One-time cleanup: server IDs (comma separated) whose old per-server copy of the commands is
# removed at start, so they stop showing every command twice. Remove it after one start.
DISCORD_CLEAR_GUILD_COMMANDS=

# ---- Database (Postgres) ----
# Running on your PC: Postgres installed locally (README, "Database"). DMbot must use an
# ordinary database user, not a superuser such as "postgres".
DATABASE_URL=postgresql://dmbot:dmbot@localhost:5432/dmbot
# The most connections DMbot holds open to Postgres (default 10). Raise it for a busy bot; with
# many shard pods give each about 4 so all together stay under Postgres' own connection limit
# (PgBouncer in transaction mode also works: DMbot sets its server per transaction).
# DATABASE_POOL_MAX=10
# Docker Compose only: passwords for the bundled Postgres (letters and numbers only).
# Compose sets DATABASE_URL for you from DMBOT_DB_PASSWORD.
POSTGRES_ADMIN_PASSWORD=
DMBOT_DB_PASSWORD=

# Local link between ears (Node) and core (Python)
EARS_WS_HOST=127.0.0.1
EARS_WS_PORT=8765
# Shared secret so only your ears service can connect to core. Any long random string.
EARS_SHARED_SECRET=

# ---- Transcription ----
# whisper-local (default, free, needs pip install -e ".[whisper]")
# deepgram      (Deepgram Nova-3, pay as you go, no GPU needed; set DEEPGRAM_API_KEY)
# cloud         (any OpenAI-compatible service, pay as you go, no GPU needed)
# none          (no text; only the capture-check counts in the core log)
# With deepgram or cloud, players' voices and Discord names go to that company. The
# consent message and the reminder each session say so, and people who agreed before
# the switch are asked again. The bot reads these settings at start-up: after changing
# them, restart it with docker compose up -d.
TRANSCRIBER=whisper-local
# Language code (en, es, de, ...) or auto to detect
TRANSCRIBE_LANGUAGE=en
# How many clips are written at once (for different servers; each server's stay in
# order). Blank: 1 for whisper-local (it fills the CPU, so only 1 works), 3 for deepgram
# and cloud.
TRANSCRIBE_WORKERS=

# Local Whisper. CPU server: base or small. NVIDIA GPU: large-v3 or turbo.
# Compute type auto picks int8 on CPU and float16 on GPU. Beam size 1 is fastest.
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_BEAM_SIZE=1

# Cloud: any OpenAI-compatible /audio/transcriptions endpoint.
CLOUD_STT_URL=https://api.openai.com/v1/audio/transcriptions
CLOUD_STT_API_KEY=
CLOUD_STT_MODEL=whisper-1

# Deepgram (TRANSCRIBER=deepgram). Get a key from your Deepgram account. The bake-off
# tool uses this key too.
DEEPGRAM_API_KEY=
# Leave these blank for the defaults: nova-3, and https://api.deepgram.com/v1/listen
DEEPGRAM_MODEL=
DEEPGRAM_LISTEN_URL=

# ---- Speech-to-text bake-off (test tool, see docs/STT_BAKEOFF.md) ----
# The bake-off tool uses DEEPGRAM_API_KEY from the Transcription section above, plus
# these. The bot never uses them. Keys go in the server's .env only: never in chat,
# issues or the repo. Bake-off runs read .env fresh each time (no restart for them).

# Fill in:
SPEECHMATICS_API_KEY=

# Leave these two blank (the usual case). Blank means:
#   Speechmatics: wss://us.rt.speechmatics.com/v2  (US)
#   Deepgram:     wss://api.deepgram.com/v1/listen
# Only set SPEECHMATICS_URL if your Speechmatics portal shows a different real-time
# address for your account (for example one with "eu" in it). It must start with wss://.
SPEECHMATICS_URL=
# DEEPGRAM_URL is for the bake-off only (wss://). The bot uses DEEPGRAM_LISTEN_URL above.
DEEPGRAM_URL=

# ---- AI (optional) ----
# Lets DMbot read a document (PDF, Word, Google Doc, or a list it can't read) and turn it
# into a names list for /dmbot names. The DM sees the list before anything is added, and
# the document's text is sent to Anthropic. Costs a little per document read (each server
# can read up to 20 a day). Leave empty to switch it off: documents are then refused and
# DMs are pointed to the names template.
ANTHROPIC_API_KEY=
# Which Claude model each kind of AI job uses (#1006). The defaults are right: leave these
# alone, or delete these three lines to always use the defaults.
#   FAST:    the simple jobs (cleaning the transcript, the off-topic filter, Find names,
#            rules lookups, quick answers for DMs): a small, cheap model.
#   CAREFUL: changes to house rules: a middle model.
#   DEEP:    story planning (PlotBot, not built yet): the strongest model.
# If a model isn't available to you, DMbot quietly uses the next cheaper one (DEEP, then
# CAREFUL, then FAST), notes it once in the log, and tries the better one again later.
# Running out of money never does this: it messages the admins instead. Each value is a
# model name starting with claude- (no quotes or spaces). The old setting AI_MODEL still
# works as AI_MODEL_FAST for now; please rename it.
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_CAREFUL=claude-sonnet-5-5
# DEEP is used today only by the story extractor, when DMBOT_STORY_EXTRACTOR_TIER=deep.
AI_MODEL_DEEP=claude-opus-5-5
# The recap's two models (#2074): the creative one writes it as plain text, the formatting one
# shapes that text into sections without changing a word.
AI_MODEL_CREATIVE=claude-opus-5-5
# Gemini as the recap writer (#2575), off unless AI_PROVIDER_CREATIVE=gemini. Only the recap's
# creative tier moves; every other job stays on Anthropic. With gemini, AI_MODEL_CREATIVE must be
# a Gemini model name (gemini-...), and GEMINI_API_KEY must be a key of a Google account with
# billing switched on (the free tier's terms let Google use what is sent). With no key the recap
# is written by the Anthropic model as before. Set the key with scripts/set-key GEMINI_API_KEY.
AI_PROVIDER_CREATIVE=anthropic
GEMINI_API_KEY=
AI_MODEL_FORMATTING=claude-haiku-5-5
# Who is messaged privately when the AI account above runs out of funds or reaches its
# monthly spend limit (#972): the owner, and a backup admin for when the owner is out of
# touch. Each is a Discord user ID (17 to 20 digits; Discord Settings > Advanced > Developer
# Mode, then right-click the person > Copy User ID). Empty: nobody is messaged, it is only
# logged. Each hears about it at most once a day. Never put real numbers in the repository.
DMBOT_ADMIN_PRIMARY_ID=
DMBOT_ADMIN_SECONDARY_ID=

# ---- Scaling and logs ----
# Discord splits a bot's servers into shards. One process with one shard is right until
# DMbot is in a few thousand servers. core and ears MUST use the same values (core
# refuses an ears that differs). SHARD_IDS lists the shards this process serves
# (blank = all of them), e.g. SHARD_COUNT=4 with SHARD_IDS=0,1 on one pod and 2,3 on another.
SHARD_COUNT=1
SHARD_IDS=
# text (easy to read) or json (one line per event, for servers and log collectors).
# Logs hold IDs only, never names, what people said, or keys.
LOG_FORMAT=text
LOG_LEVEL=INFO
# Days that Undo works on campaign memory (names, connections). After each session, older
# undo history is deleted so it doesn't grow forever. Whole days, 1 or more.
MEMORY_CHANGELOG_KEEP_DAYS=30

# ---- Website API (#435) ----
# The API behind the customer website (python -m dmbot.web, the web-api container). Leave
# these empty until the website goes live; the container only starts with
# COMPOSE_PROFILES=web. Discord Developer Portal (https://discord.com/developers/applications)
# → your app → OAuth2: the Client ID, the Client Secret (Reset Secret), and add WEB_API_URL
# + /auth/discord/callback as a Redirect (not needed until customer sign-in opens). Never
# Bot → Reset Token for this: that is the bot's own token (DISCORD_TOKEN) and resetting it
# logs the bot out.
COMPOSE_PROFILES=
# The website API's own database password (its role, dmbot_web, sees only the signed-in
# person's servers). Any long random string. On a server whose database already exists,
# also create the role once: README, "Database".
DMBOT_WEB_DB_PASSWORD=
# WEB_DB_ANY_ROLE=1 lets the API connect as another database user: localhost tests only.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Signs the sign-in check. Any random string of 32 characters or more.
WEB_SECRET_KEY=
# The website's address and this API's public address, both https. They must be on the
# same site (for example https://dmbot.example and https://api.dmbot.example).
WEB_SITE_URL=
WEB_API_URL=
# Days a sign-in lasts (1 to 90).
WEB_SESSION_DAYS=30
# The payment company: stripe (the owner's choice, 2026-10-13). Empty: buying says payments
# are off. "fake" is for testing on localhost only.
PAYMENT_PROVIDER=
# The signing secret of the payment company's webhook endpoint (16 characters or more;
# Stripe's starts whsec_).
PAYMENT_WEBHOOK_SECRET=
# Stripe (#1110), used when PAYMENT_PROVIDER=stripe. Set these with scripts/set-key, never by
# hand in a shared place. A secret key (sk_test_... while testing, sk_live_... for real
# payments: the key itself says which, there is no separate switch) and the id of each Price
# (price_...) in the Stripe dashboard: one per buyable plan, and the +10 extra hours.
STRIPE_SECRET_KEY=
STRIPE_PRICE_TABLE=
STRIPE_PRICE_TWO_TABLES=
STRIPE_PRICE_GUILD=
STRIPE_PRICE_EXTRA_HOURS=
# The recap audio add-on's monthly price (#1389; the owner makes it, #1385). Leave EMPTY until it
# exists: the add-on is then not for sale and its button stays hidden (Guild has audio anyway).
STRIPE_PRICE_RECAP_AUDIO=
# 1 to ask Stripe to be the seller (Managed Payments, #1096): each checkout opts in. The owner
# accepts Stripe's terms in the dashboard first; leave 0 until the sandbox run has checked it.
STRIPE_MANAGED_PAYMENTS=0
# The API version DMbot sends is fixed in the code (dmbot/web/stripe.py, API_VERSION). Create
# the webhook endpoint on that same version (Stripe dashboard, Developers, Webhooks, the
# endpoint's "API version"), or its events can have another shape.
# The website's "Say hello" forms (#665) post each message as a GitHub Discussion. A
# fine-grained GitHub token for this one repository with only Discussions: Read and write.
# Empty: the forms say to try later. The repository needs Discussions turned on and two
# discussion categories named exactly "Feedback" and "Questions".
GITHUB_FEEDBACK_TOKEN=
# The repository to post in, as owner/name. Empty means smv620/Discord-DMbot.
GITHUB_FEEDBACK_REPO=
# Where "a support ticket is waiting" is emailed (#1340). One address. Empty: tickets are still
# kept and shown on the admin page, and nobody is emailed. The email holds the ticket's subject
# and the conversation so far. Needs the SMTP settings.
SUPPORT_TEAM_EMAIL=
# Cloudflare Turnstile's secret key (the "are you a person?" check on the forms). Needed
# when GITHUB_FEEDBACK_TOKEN is set, except on localhost. Its site key goes in the website's
# build as PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=
# The header your proxy puts the visitor's address in, for the one-message-per-10-minutes
# limit: CF-Connecting-IP behind Cloudflare. Needed when GITHUB_FEEDBACK_TOKEN is set,
# except on localhost. The API must then be reachable only through that proxy (the
# Cloudflare Tunnel, see CLOUDFLARE_TUNNEL_TOKEN below), or anyone could pick their own
# address.
WEB_CLIENT_IP_HEADER=
# Signs the personal links on the website (the greeting and experience points), so a
# link can't be made by guessing an ID (#1228). 32 or more random characters, for example
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`. Empty: personal links are
# off. Never commit it.
LINK_TOKEN_SECRET=
# Sending email (#1229): sign-in links, move codes and the Try It emails. Leave SMTP_HOST empty
# and nothing is ever sent. Two choices. Set the password with scripts/set-key and the rest in
# an editor.
#  - Resend (the plan, #1347, docs/EMAIL.md (PR #1346)): SMTP_HOST=smtp.resend.com, SMTP_PORT=587,
#    SMTP_USER=resend, SMTP_APP_PASSWORD a Resend API key (starts with re_), and
#    MAIL_FROM=DMbot <accounts@getdmbot.com>.
#  - Gmail (the other choice): SMTP_HOST=smtp.gmail.com, SMTP_USER the Gmail address,
#    SMTP_APP_PASSWORD a Google app password (16 letters, never the account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
# The From address on every email. With Resend: DMbot <accounts@getdmbot.com>.
MAIL_FROM=
# The support flow (#1431). Every support question gets a thank-you, an answer from DMbot's
# helper (the AI) and, when the helper is not enough, a person. Empty: these two fall back to
# MAIL_FROM.
#  - MAIL_SUPPORT_FROM: what people receive about their question, for example
#    DMbot support <info@getdmbot.com>. Their replies come back to it.
#  - MAIL_ALERTS_FROM: the alerts to the team (SUPPORT_TEAM_EMAIL), for example
#    DMbot alerts <alerts@example.org>. (The real address is private; see docs/EMAIL.md.)
MAIL_SUPPORT_FROM=
MAIL_ALERTS_FROM=
# DMbot refuses admin@getdmbot.com as any of the three From addresses above: that address is for a
# person's own live replies, never for automatic mail (#1425).
# Owner alerts (#1907): one short email to the owner when the AI, Deepgram, Stripe, mail or the
# database fails. OWNER_ALERT_EMAIL is the owner's private address: set it only here on the server
# (never in the repository, an issue or a chat). Empty: no alert emails (the log says so once).
# MAIL_ALERTS_REPLY_TO is the optional Reply-To on those emails; empty means none.
OWNER_ALERT_EMAIL=
MAIL_ALERTS_REPLY_TO=
# The signing secret of the mail service's inbound webhook (it starts with whsec_), for
# POST /mail/inbound. Empty: replies by email are not read.
MAIL_INBOUND_SECRET=
# Where people's emailed replies to a support question go, for example reply.getdmbot.com: a
# subdomain only the mail service receives, because the main domain's mail goes to the team's
# inboxes through the host's email routing. Plain domain name only. Empty: the support address's
# own domain (MAIL_SUPPORT_FROM).
MAIL_REPLY_DOMAIN=
# The model for DMbot's support helper. Empty: the strongest tier's current default. It uses
# ANTHROPIC_API_KEY, so the website's API needs that key too.
SUPPORT_AI_MODEL=
# The postal address printed at the bottom of offer emails (US law asks for one). Offer
# emails (the trial-end and extension ones) are not sent while it is empty. Use | for a
# line break.
MAIL_POSTAL_ADDRESS=
# The most emails sent in one day. Keep it at or under the provider's daily limit (Gmail about
# 500; for Resend read the free daily limit on its dashboard, and see docs/EMAIL.md).
MAIL_DAILY_CAP=400
# The admin page (/admin on the website, #772): the only email addresses that may sign in,
# separated by commas. Empty: the admin sign-in is off.
ADMIN_EMAILS=
# The admin password, scrambled. Don't type it here: run scripts/set-admin-password.
# Empty: use "Sign in with Google" instead.
ADMIN_PASSWORD_HASH=
# "Sign in with Google" for the admin page: Google Cloud console -> APIs & Services ->
# Credentials -> Create OAuth client ID (web application), with WEB_API_URL +
# /admin/auth/google/callback as the redirect URI. Empty: only the password works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Puts the website's API online so Google can sign you in as admin (#836). Get the token in
# Cloudflare: Networks -> Tunnels -> your tunnel. Set it with scripts/set-key
# CLOUDFLARE_TUNNEL_TOKEN, never by editing this file or pasting it anywhere else. Empty:
# the tunnel stays off. Steps: docs/DEPLOY.md, "Put the admin API online".
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Debugging ----
# 1 = ears logs audio health per utterance (user IDs and packet counts only, no audio).
DMBOT_DEBUG_AUDIO=0

# ---- Plan checks ----
# 0 (the default): DMbot records everyone's listening hours but never refuses a start or
# warns about hours. 1: it checks the owner's plan and hours at /dmbot start and warns the
# DM as hours run low. Turn it on only once people can pay on the website (WEB_SITE_URL
# above is where the messages send them). After a change, restart the bot (core) and the
# website's API (web-api), which reads it too (its hand-over accept checks the campaign cap).
DMBOT_ENFORCE_PLANS=0

# Importing older sessions on the website (#2105). 0 (the default): the import routes answer
# "not found" for everyone. dev1 turns it on (1) once a real import has been checked. After a
# change, restart the website's API (web-api).
DMBOT_IMPORTS=0
# Importing for chosen servers only (#2259): Discord server numbers separated by commas. Importing
# is then on in those servers although DMBOT_IMPORTS is 0. Test servers only; leave empty. Read by
# the bot and the website's API, so restart both after a change.
DMBOT_IMPORTS_SERVERS=

# ---- DM sidebar ----
# 0 (the default): a DM's voice messages, typed questions and "hold on, I need to find…"
# get "Quick answers aren't switched on yet." (or nothing at the table). 1: they are answered
# (needs ANTHROPIC_API_KEY). Turn it on only after the sidebar's test answers have been read
# (#954). After a change, restart the bot (core).
DMBOT_SIDEBAR=0

# ---- Images in the table chat ----
# 0 (the default): an image posted in the table chat is ignored. 1: it is described once by the
# AI for the transcript (needs ANTHROPIC_API_KEY, a plan with AI, and a yes given under consent
# wording that mentions pictures, `IMAGE_TERMS_VERSION`: until the separate go-live change that
# brings that wording lands, nobody has one and nothing is read; #2450). The image is never stored.
# DMBOT_TABLE_IMAGES=0
# The most images one campaign has described in a day (each counts toward its AI use; the count
# is kept in the database). Past it the transcript notes the picture as not described.
# DMBOT_TABLE_IMAGES_PER_DAY=40

# A time jump suggested from vague narration (TimeBot, #1758): when a DM's narration probably
# passes game time but the strict phrases ("an hour later") don't match it ("you walk for a
# while"), the DM screen offers a [+2 hours] button. The clock never moves by itself. It sends the
# DM's one line and the game time to the AI (the smallest model), at most 20 calls a session for
# a campaign, on paid plans only. 0: off, nothing calls the AI (the default until dev1 has run a
# live check). After a change, restart the bot (core).
DMBOT_TIME_SUGGESTIONS=0

# The story extractor (phase 5a): reads each session after it ends and proposes what was said for
# the DM to confirm. 0: off, nothing calls the AI (the default; not shown to customers). It stays
# off until its prompt passes the measurement in docs/costs.md (#1282). After a change, restart
# the bot (core).
DMBOT_STORY_EXTRACTOR=0

# The first live heads-up (#2068): on the DM screen, while a session runs, when a character you
# confirmed as dead is voiced at the table. No AI. 0: off (the default, until the live check at the
# test table). The minutes between two of them: 0 to 120, default 5. Restart the bot after a change.
DMBOT_LIVE_HEADS_UP=0
# DMBOT_LIVE_HEADS_UP_MINUTES=5

# When the DM says one of their secret names at the table, DMbot asks them at once whether it is
# revealed now (#2088). It only asks. 1: on (the default); 0: off. Restart the bot after a change.
# DMBOT_SECRET_REVEAL_ASK=1
# When it is on: the model tier that reads the transcript (fast, careful or deep; default fast)
# and the most calls one session may make (default 480, from 1 to 5000). Nothing to set while it
# is off. After a change, restart the bot (core).
# DMBOT_STORY_EXTRACTOR_TIER=fast
# DMBOT_STORY_EXTRACTOR_MAX_CALLS=480
# The most calls all of one campaign's sessions may make in a day (default 960, two sessions'
# worth; from 1 to 50000):
# DMBOT_STORY_EXTRACTOR_MAX_CALLS_DAY=960

# "Did they mean…?" (the Transcript Cleaner): one fast AI call per question puts the most likely
# name first, marked "(likely)". It never changes a line; the DM still answers. The most calls a
# session makes (default 40; 0 turns it off):
# DMBOT_CLEANER_RANK_MAX=40

# Continuity warnings (phase 5a): after a session, what was said is checked against the story the
# DM already confirmed, and the DM is shown the clashes. These are the numbers behind "possible",
# "probable" and "likely" (a share from 0 to 1), and how much confirmed story a campaign needs
# before any warning is shown. The defaults are the starting point; leave them unless a test says
# otherwise. After a change, restart the bot (core).
# DMBOT_CONTINUITY_POSSIBLE=0.25
# DMBOT_CONTINUITY_PROBABLE=0.5
# DMBOT_CONTINUITY_LIKELY=0.8
# DMBOT_CONTINUITY_MIN_FACTS=50
# DMBOT_CONTINUITY_MIN_SESSIONS=3

# Story threads (phase 5c): a thread that is hinted, open or going on is "stalled" when this many
# sessions have started since it last moved. The after-session report says how many are. After a
# change, restart the bot (core).
# DMBOT_THREAD_STALLED_SESSIONS=3

# Story recall (phase 5b): the most characters of the campaign's story that one helper (the NPC
# tracker, PlotBot, the DM sidebar) is handed at a time. Smaller is faster and cheaper; larger
# remembers more. After a change, restart the bot (core).
# DMBOT_RECALL_BUDGET=4000

# ---- Free access ----
# Discord accounts that use DMbot free, with no hours or campaign limits: the owner's own
# (#771). To find one: in Discord, turn on Settings > Advanced > Developer Mode, then
# right-click the person and pick Copy User ID. Several are separated by commas. Never
# put real numbers in the repository: only in the server's .env. After a change, restart
# both the bot (core) and the website's API (web-api).
DMBOT_FREE_USERS=

# ---- Test recordings ----
# Empty (the default): DMbot never saves anyone's voice. On the TEST server only, list its
# Discord server number here (several are separated by commas). Then people who press
# "Save my voice for tests" in their consent message have their voices kept as audio files
# on DMbot's own computer, only to re-check that DMbot still works. They are never published,
# never in the database or a backup, and are deleted after 7 days unless a session is marked
# to keep; "Stop saving my voice" deletes a person's files at once. After a change, restart core.
DMBOT_TEST_RECORDING_GUILDS=
# Where the files go inside the core container (a volume, owner-only). The default is right
# for docker compose.
DMBOT_TEST_RECORDINGS_DIR=/var/lib/dmbot/test-recordings

# The DM sidebar's quick answers use what the DM has confirmed about the story (phase 5b): the
# facts around the names a question mentions, for the audience "players" (no secrets, no notes),
# each cited by the AI and checked in code. 1: on (the default); 0: off, the prompt is exactly the
# old one. The budget is how many characters of confirmed story one question may add (200 to
# 4000, default 1000). After a change, restart the bot (core).
# DMBOT_SIDEBAR_RECALL=1
# DMBOT_SIDEBAR_RECALL_BUDGET=1000

# Cinematic recaps (#1382): after a session, DMbot writes an in-world "previously on…" away from
# the table and emails the DM when it is ready. The DM reads, edits and posts it on the website;
# nothing reaches the table unless they press Post. 0: off (the default) until the first
# real-session check (python -m dmbot.devtools.recap_measure). For campaigns whose plan includes
# story memory (not Try It). Needs the mail settings (SMTP_*) and WEB_SITE_URL. After a change,
# restart the bot (core).
DMBOT_RECAPS=0

# The recap's narration and music (#1383). Needs DMBOT_RECAPS=1, the ELEVENLABS account of the
# owner (Creator plan or above: music for commercial use) and the narrator's voice id (#1385).
# Set the key with scripts/set-key, never by hand in a chat. With no key the recap is made
# text-only and nothing fails. These lines are active (empty) so that scripts/set-key can set the
# key; they do nothing until DMBOT_RECAPS=1 and a key exist. The credit cap is for ONE recap (about 7,000 credits is usual).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# The voice model (default eleven_v3, which understands the delivery tags). dev1 compares it with
# a newer one by ear before go-live (docs/costs.md).
ELEVENLABS_SPEECH_MODEL=eleven_v3
DMBOT_RECAP_AUDIO_MAX_CREDITS=15000
# 1: the recap's mood cues (tense, somber, hopeful...) reach the voice as delivery tags, once where the
# mood changes (#1983). 0: only whisper, sigh and pauses, so a narration can be compared by ear.
DMBOT_RECAP_VOICE_TAGS=1
# The most recaps, and narrated recaps, one campaign may make in a calendar month (UTC), to keep
# the bill under what a plan earns (#1428). A Try again counts; a failed job does not; free access
# and grants are not limited. Past the allowance the DM screen says when the next one is. Like the
# lines above, they do nothing until DMBOT_RECAPS=1 and a key exist.
DMBOT_RECAPS_PER_MONTH=10
DMBOT_RECAP_AUDIO_PER_MONTH=8

# The note on the DM screen when a session starts (story memory, #1403): the last recap, what is open
# about the names heard last time, what was lost or ended, and how many things said at the table wait
# to be checked. Built from what the DM confirmed, no AI call; only for plans with story memory.
# 1: on (the default); 0: off. After a change, restart the bot (core).
# DMBOT_PRESESSION_NOTE=1
