# Copy to .env and fill in. Never commit .env.
# On the server, run scripts/set-key to add a key without editing this file (easy from a phone).

# Discord bot token (Discord Developer Portal → your app → Bot → Reset Token)
DISCORD_TOKEN=

# Your private test server's ID (right-click server → Copy Server ID, with Developer Mode on).
# Slash commands register instantly in this server during development.
DISCORD_DEV_GUILD_ID=

# ---- Database (Postgres) ----
# Running on your PC: Postgres installed locally (README, "Database"). DMbot must use an
# ordinary database user, not a superuser such as "postgres".
DATABASE_URL=postgresql://dmbot:dmbot@localhost:5432/dmbot
# Docker Compose only: passwords for the bundled Postgres (letters and numbers only).
# Compose sets DATABASE_URL for you from DMBOT_DB_PASSWORD.
POSTGRES_ADMIN_PASSWORD=
DMBOT_DB_PASSWORD=

# Local link between ears (Node) and core (Python)
EARS_WS_HOST=127.0.0.1
EARS_WS_PORT=8765
# Shared secret so only your ears service can connect to core. Any long random string.
EARS_SHARED_SECRET=

# ---- Transcription ----
# whisper-local (default, free, needs pip install -e ".[whisper]")
# deepgram      (Deepgram Nova-3, pay as you go, no GPU needed; set DEEPGRAM_API_KEY)
# cloud         (any OpenAI-compatible service, pay as you go, no GPU needed)
# none          (no text; only the capture-check counts in the core log)
# With deepgram or cloud, players' voices and Discord names go to that company. The
# consent message and the reminder each session say so, and people who agreed before
# the switch are asked again. The bot reads these settings at start-up: after changing
# them, restart it with docker compose up -d.
TRANSCRIBER=whisper-local
# Language code (en, es, de, ...) or auto to detect
TRANSCRIBE_LANGUAGE=en
# How many clips are written at once (for different servers; each server's stay in
# order). Blank: 1 for whisper-local (it fills the CPU, so only 1 works), 3 for deepgram
# and cloud.
TRANSCRIBE_WORKERS=

# Local Whisper. CPU server: base or small. NVIDIA GPU: large-v3 or turbo.
# Compute type auto picks int8 on CPU and float16 on GPU. Beam size 1 is fastest.
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_BEAM_SIZE=1

# Cloud: any OpenAI-compatible /audio/transcriptions endpoint.
CLOUD_STT_URL=https://api.openai.com/v1/audio/transcriptions
CLOUD_STT_API_KEY=
CLOUD_STT_MODEL=whisper-1

# Deepgram (TRANSCRIBER=deepgram). Get a key from your Deepgram account. The bake-off
# tool uses this key too.
DEEPGRAM_API_KEY=
# Leave these blank for the defaults: nova-3, and https://api.deepgram.com/v1/listen
DEEPGRAM_MODEL=
DEEPGRAM_LISTEN_URL=

# ---- Speech-to-text bake-off (test tool, see docs/STT_BAKEOFF.md) ----
# The bake-off tool uses DEEPGRAM_API_KEY from the Transcription section above, plus
# these. The bot never uses them. Keys go in the server's .env only: never in chat,
# issues or the repo. Bake-off runs read .env fresh each time (no restart for them).

# Fill in:
SPEECHMATICS_API_KEY=

# Leave these two blank (the usual case). Blank means:
#   Speechmatics: wss://us.rt.speechmatics.com/v2  (US)
#   Deepgram:     wss://api.deepgram.com/v1/listen
# Only set SPEECHMATICS_URL if your Speechmatics portal shows a different real-time
# address for your account (for example one with "eu" in it). It must start with wss://.
SPEECHMATICS_URL=
# DEEPGRAM_URL is for the bake-off only (wss://). The bot uses DEEPGRAM_LISTEN_URL above.
DEEPGRAM_URL=

# ---- AI (optional) ----
# Lets DMbot read a document (PDF, Word, Google Doc, or a list it can't read) and turn it
# into a names list for /dmbot names. The DM sees the list before anything is added, and
# the document's text is sent to Anthropic. Costs a little per document read (each server
# can read up to 20 a day). Leave empty to switch it off: documents are then refused and
# DMs are pointed to the names template.
ANTHROPIC_API_KEY=
# Which Claude model to use (a cheap, fast one is plenty for this).
AI_MODEL=claude-haiku-4-5-20251001

# ---- Scaling and logs ----
# Discord splits a bot's servers into shards. One process with one shard is right until
# DMbot is in a few thousand servers. core and ears MUST use the same values (core
# refuses an ears that differs). SHARD_IDS lists the shards this process serves
# (blank = all of them), e.g. SHARD_COUNT=4 with SHARD_IDS=0,1 on one pod and 2,3 on another.
SHARD_COUNT=1
SHARD_IDS=
# text (easy to read) or json (one line per event, for servers and log collectors).
# Logs hold IDs only, never names, what people said, or keys.
LOG_FORMAT=text
LOG_LEVEL=INFO
# Days that Undo works on campaign memory (names, connections). After each session, older
# undo history is deleted so it doesn't grow forever. Whole days, 1 or more.
MEMORY_CHANGELOG_KEEP_DAYS=30

# ---- Website API (#435) ----
# The API behind the customer website (python -m dmbot.web, the web-api container). Leave
# these empty until the website goes live; the container only starts with
# COMPOSE_PROFILES=web. Discord Developer Portal → your app → OAuth2: the Client ID, the
# Client Secret (Reset Secret), and add WEB_API_URL + /auth/discord/callback as a Redirect.
COMPOSE_PROFILES=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Signs the sign-in check. Any random string of 32 characters or more.
WEB_SECRET_KEY=
# The website's address and this API's public address, both https. They must be on the
# same site (for example https://dmbot.example and https://api.dmbot.example).
WEB_SITE_URL=
WEB_API_URL=
# Days a sign-in lasts (1 to 90).
WEB_SESSION_DAYS=30

# ---- Debugging ----
# 1 = ears logs audio health per utterance (user IDs and packet counts only, no audio).
DMBOT_DEBUG_AUDIO=0
